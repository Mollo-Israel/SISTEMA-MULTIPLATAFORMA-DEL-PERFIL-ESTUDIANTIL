{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "declaration": false,
    "sourceMap": true,
    "incremental": false,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../shared/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
