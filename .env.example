# =============================================================================
#  AFINIA — Variables de entorno (especificación §100)
#
#  Copie este archivo como `.env` y complete los valores. Nunca versione el
#  `.env` real: contiene secretos.
# =============================================================================

# ===== Entorno y API =====
NODE_ENV=development
API_PORT=3010
# Orígenes del cliente web, separados por coma. Obligatorio en producción.
WEB_ORIGINS=http://localhost:5173
# Alias histórico de WEB_ORIGINS; se mantiene por compatibilidad.
CORS_ORIGINS=http://localhost:5173
# Swagger queda deshabilitado en producción salvo que se ponga true.
SWAGGER_ENABLED=

# Limpieza de archivos subidos que nunca se adjuntaron (§136).
# La gracia separa «abandonado» de «todavía en curso»: no baje de unas horas.
ORPHAN_CLEANUP_ENABLED=true
ORPHAN_CLEANUP_INTERVAL_MS=21600000
ORPHAN_CLEANUP_GRACE_HOURS=24
ORPHAN_CLEANUP_BATCH=200

# ===== Base de datos (PostgreSQL) =====
# Puerto del HOST donde se publica el contenedor (dentro sigue siendo 5432).
# 5435 evita chocar con un PostgreSQL instalado en la máquina (V2 §10.1). Si
# su base ya corre en otro puerto, ponga aquí ese.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=perfil_user
POSTGRES_PASSWORD=perfil_pass
POSTGRES_DB=perfil_estudiantil

# ===== Sesiones (§14) =====
# En producción ambos secretos son obligatorios, deben tener al menos 16
# caracteres y ser distintos entre sí: la API no arranca si no es así.
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresco
# El access token es corto; la sesión larga vive en el refresh token, que sí
# puede revocarse.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# La web recibe el refresh token en una cookie HttpOnly (V2 §18). Con la web y
# la API en el mismo sitio (mismo dominio raíz) basta «lax». Si están en sitios
# distintos, use «none» (exige HTTPS; la cookie se marca Secure).
REFRESH_COOKIE_SAMESITE=lax
# Secure se activa solo en producción; true lo fuerza también en desarrollo.
REFRESH_COOKIE_SECURE=false

# ===== Activación y recuperación (V2 §15.3) =====
# Cuánto sirven el enlace y el código del correo.
ACTIVATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Pausa antispam entre dos correos de la misma cuenta, y tope por día. Sin
# ellos, pulsar «reenviar» diez veces manda diez correos al mismo buzón, y eso
# basta para que Outlook marque a Afinia como spam.
ACTIVATION_RESEND_COOLDOWN_SECONDS=120
ACTIVATION_RESEND_MAX_PER_DAY=5
# Intentos con el código de 6 dígitos antes de anularlo (hay que pedir otro).
ACTIVATION_CODE_MAX_ATTEMPTS=10

# ===== Identidad institucional (§11) =====
# Dominios autorizados, separados por coma. Obligatorio en producción; si se
# deja vacío en desarrollo, no se restringe el dominio y se avisa por consola.
# No se codifica ningún dominio en el código fuente.
INSTITUTIONAL_EMAIL_DOMAINS=univalle.edu,est.univalle.edu

# ===== Correo (§101) — guía completa en docs/CORREO_REAL.md =====
# Con SMTP_HOST vacío el correo se SIMULA: los mensajes se escriben en el
# registro de la API y en api/.mail-outbox, pero no llegan a ningún buzón.
# Para que lleguen de verdad basta rellenar este bloque y reiniciar la API.
# Pruebe la configuración con:  npm run mail:test -- su.correo@dominio.com
#
# MAIL_TRANSPORT: auto (SMTP si hay SMTP_HOST) | smtp | console
MAIL_TRANSPORT=auto
# Dirección pública de la web: es la que va dentro del botón del correo.
WEB_APP_URL=http://localhost:5173
# Zona horaria de las fechas que se escriben en los correos.
APP_TIMEZONE=America/La_Paz

SMTP_HOST=
SMTP_PORT=587
# Vacío = automático: true con el puerto 465, false (STARTTLS) con el 587.
SMTP_SECURE=
# login (usuario y contraseña) | oauth2 | none
SMTP_AUTH=login
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Con Gmail y Outlook debe ser la MISMA cuenta de SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=Afinia · Univalle
SMTP_REPLY_TO=
# Ritmo máximo de envío, para no disparar los filtros del proveedor.
SMTP_MAX_PER_MINUTE=20
# Solo para servidores de prueba locales con certificado propio. Nunca en real.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Solo con SMTP_AUTH=oauth2 (p. ej. Microsoft 365 sin SMTP AUTH básico).
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
# Copia local de cada correo (solo fuera de producción). Vacío = api/.mail-outbox
MAIL_CAPTURE_DIR=
# La cola de correos de cuenta. Solo se desactiva para depurar.
MAIL_WORKER_ENABLED=true

# --- Plantillas: copie un bloque sobre las variables de arriba ---------------
#
# Gmail (recomendado para empezar; ~500 correos/día):
#   requiere verificación en dos pasos y una «contraseña de aplicación»
#   (myaccount.google.com → Seguridad → Contraseñas de aplicaciones).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu.cuenta@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=tu.cuenta@gmail.com
#
# Brevo (antes Sendinblue; mejor entrega a Outlook, 300 correos/día gratis):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu_login_smtp@smtp-brevo.com
# SMTP_PASSWORD=tu_clave_smtp
# SMTP_FROM=no-reply@tu-dominio-verificado.com
#
# Microsoft 365 / correo institucional (si la universidad lo permite):
#   Microsoft está retirando el envío con usuario y contraseña; si aparece el
#   error 5.7.139, use SMTP_AUTH=oauth2 o pida a TI un relé SMTP.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=afinia@univalle.edu
# SMTP_PASSWORD=...
# SMTP_FROM=afinia@univalle.edu
#
# Mailpit (ver los correos con su diseño real sin enviarlos a nadie):
#   npm run mail:preview   y abra http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_AUTH=none
# SMTP_FROM=no-reply@afinia.test

# ===== Protección de abuso (§15) =====
# Peticiones por minuto y por IP. Los valores por defecto del código son los de
# producción (300 global, 10 en login, 5 en activación). En desarrollo conviene
# elevarlos: una suite de integración hace decenas de inicios de sesión
# seguidos desde la misma IP y se bloquearía a sí misma.
RATE_LIMIT_GLOBAL_PER_MINUTE=5000
RATE_LIMIT_AUTH_PER_MINUTE=2000
RATE_LIMIT_ACTIVATION_PER_MINUTE=2000

# ===== Almacenamiento de archivos (§27) =====
# Los archivos NO se sirven como estáticos: la descarga pasa por
# GET /api/files/:key, que exige sesión y comprueba autorización.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_MB=10

# ===== Motor de Validación (§26, §29, §31, §76) =====
# El worker vive dentro de la API: la cola es una tabla y un temporizador la
# atiende. §76 permite esta vía para no tener que levantar Redis.
VALIDATION_WORKER_ENABLED=true
# Cada cuánto mira la cola cuando está vacía.
VALIDATION_WORKER_POLL_MS=5000
# Cuántos trabajos procesa por vuelta.
VALIDATION_WORKER_BATCH=3
# Pasado este tiempo, un trabajo reclamado por un proceso que ya no existe
# vuelve a la cola. Es lo que impide perder trabajo al reiniciar.
VALIDATION_WORKER_STALE_MS=300000

# Comprobación de enlaces externos (§31). Apagarlo deja todo en UNVERIFIED, que
# es honesto donde no hay salida a internet. Nunca alcanza direcciones internas
# ni el servicio de metadata de la nube, esté encendido o apagado.
LINK_CHECK_ENABLED=true
LINK_CHECK_TIMEOUT_MS=8000

# OCR (§29, paso 2). El adaptador usa tesseract.js si está instalado; no es
# dependencia del proyecto porque descarga unos 15 MB de modelo en su primer
# uso. Sin él, los documentos ilegibles quedan INCONCLUSIVE, que es lo que §29
# manda: el recurso se conserva y nadie afirma nada sobre él.
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng

# ===== Integraciones opcionales =====
# Token de GitHub para corroborar repositorios públicos (§37). Opcional: sin él
# se consulta la API pública, con menos cuota.
GITHUB_TOKEN=
# Tamaño mínimo de grupo para publicar un agregado en analítica (§65).
ANALYTICS_MIN_GROUP_SIZE=5

# ===== Inspección de repositorios (§37, §38) =====
# GitHub es opcional: un proyecto no necesita repositorio para existir. Cuando
# lo hay, se consulta solo metadata pública y la presencia de manifiestos;
# nunca se descarga ni se analiza el repositorio completo.
REPOSITORY_CHECK_ENABLED=true

# ===== Asistente de IA (V2 §43) — opcional =====
# Con AI_PROVIDER=none el sistema funciona completo: la IA solo sugiere, nunca
# decide afinidad, respaldo, aprobaciones ni participación.
# openai_compatible = cualquier API compatible con /v1/chat/completions.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=4000
# Pedidos de sugerencia por persona y minuto (cada uno es una llamada al modelo).
AI_RATE_LIMIT_PER_MINUTE=20

# ===== Moderación de nombres de equipo (V2 §44) =====
# Primera barrera, por reglas: longitud (3-60), caracteres, sin enlaces,
# correos ni teléfonos, y términos prohibidos por palabra completa (también con
# números en lugar de letras o letras separadas). La API trae una lista base;
# aquí se agregan términos propios, separados por coma, sin distinguir
# mayúsculas ni tildes. Con IA configurada, lo que pasa las reglas puede quedar
# «marcado» y no se comparte hasta corregirlo; si la IA falla, no bloquea.
TEAM_NAME_FORBIDDEN_TERMS=

# ===== Centro de ayuda (V2 §65) =====
# Video explicativo opcional que se muestra en «Ayuda» (YouTube, Stream, etc.).
HELP_VIDEO_URL=

# ===== Administrador inicial (seed) =====
ADMIN_EMAIL=admin@univalle.edu
# §13 exige 12 caracteres como mínimo.
ADMIN_PASSWORD=AfiniaAdmin2026*

# ===== Motor de Afinidad V2 (§48 a §57, §131) =====
# Al arrancar, la API recalcula los perfiles cuyo puntaje todavía lleva la
# versión anterior del motor. Es necesario porque V1 guardaba puntos crudos sin
# techo y V2 un porcentaje sobre 100: dejarlos sin tocar haría que el mismo
# número significara otra cosa sin que nadie lo notara.
#
# Se agota solo: una vez recalculados, no encuentra nada que hacer. Ponerlo en
# false solo tiene sentido si se prefiere lanzarlo a mano con
# POST /affinity/recalculate-all, por ejemplo para no cargar la base durante un
# despliegue.
AFFINITY_BACKFILL_ON_BOOT=true

# ===== Analítica (§63, §64, §65) =====
# Umbral de privacidad para grupos pequeños. Un agregado deja de ser agregado
# cuando el grupo es diminuto: «el 100 % de octavo semestre tiene afinidad baja
# con Redes» es una estadística si son cuarenta y una ficha personal si son dos.
# Por debajo de este número se publica el grupo y su tamaño, pero no su
# desglose.
ANALYTICS_MIN_GROUP_SIZE=5

# ===== Gamificación por actividad (V2 §31.2) =====
# Techo de puntos que una actividad puede dar por participación confirmada.
# Quien la propone lo fija dentro de este rango y Dirección lo aprueba junto
# con la actividad. Los puntos nunca tocan afinidad ni nota.
GAMIFICATION_ACTIVITY_MAX_POINTS=50
