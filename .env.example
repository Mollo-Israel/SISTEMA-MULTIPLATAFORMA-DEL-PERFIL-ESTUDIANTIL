# ===== Base de datos (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=perfil_user
POSTGRES_PASSWORD=perfil_pass
POSTGRES_DB=perfil_estudiantil

# ===== API =====
API_PORT=3000
NODE_ENV=development

# ===== Autenticación (JWT) =====
# En producción es obligatorio y debe tener al menos 16 caracteres propios:
# la API no arranca si conserva este valor de ejemplo.
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresco
JWT_REFRESH_EXPIRES=7d

# ===== CORS =====
# Orígenes permitidos, separados por coma. En desarrollo puede quedar vacío
# (se permite cualquier origen y se avisa por consola). En producción es
# obligatorio: la API no arranca sin él.
# Ejemplo: CORS_ORIGINS=https://afinia.univalle.edu,https://app.afinia.univalle.edu
CORS_ORIGINS=

# ===== Almacenamiento de evidencias =====
# Driver activo: local (disco). El puerto StoragePort permite agregar otro
# proveedor sin tocar los módulos que lo consumen.
# Valores admitidos: local | cloudinary
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ===== Usuario administrador inicial (seed) =====
ADMIN_EMAIL=admin@univalle.edu
ADMIN_PASSWORD=Admin123*

# Solo si STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
