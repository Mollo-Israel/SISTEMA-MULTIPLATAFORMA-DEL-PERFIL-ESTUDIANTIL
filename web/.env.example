VITE_API_URL=http://localhost:3010/api

# V3.2 §8.2: en producción la activación muestra solo «Tengo el código» (y el
# enlace del botón del correo abre la pantalla ya preparada). Ponerlo en true
# vuelve a mostrar la pestaña para pegar el enlace a mano.
# VITE_ACTIVATION_PASTE_LINK=false

# V3.2 §60: «Correo (configuración técnica)» no forma parte del producto. Solo
# se muestra en desarrollo o con este modo técnico explícito (la API además
# exige MAIL_DIAGNOSTICS_ENABLED=true fuera de desarrollo).
# VITE_TECHNICAL_MODE=false

# V3.2 §38: zona horaria en la que se muestran y editan fechas y horas,
# sea cual sea la del navegador.
VITE_APP_TIMEZONE=America/La_Paz
