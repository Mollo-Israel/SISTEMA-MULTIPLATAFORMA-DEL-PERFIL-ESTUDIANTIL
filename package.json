{
  "name": "sistema-perfil-estudiantil",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Multiplataforma para la Construcción del Perfil Estudiantil Dinámico - Ingeniería en Sistemas Informáticos, Univalle. Implementación del 30% inicial.",
  "workspaces": [
    "shared",
    "api"
  ],
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f postgres",
    "shared:build": "npm run build --workspace shared",
    "api:dev": "npm run start:dev --workspace api"
  },
  "engines": {
    "node": ">=20"
  }
}
