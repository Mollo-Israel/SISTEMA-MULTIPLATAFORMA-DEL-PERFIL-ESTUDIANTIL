# Variables de PRODUCCIÓN de la API. Se cargan en el panel de Railway; este
# archivo es solo la lista. No escriba valores reales aquí.
# La guía completa está en docs/DESPLIEGUE.md.

NODE_ENV=production
SWAGGER_ENABLED=false

# Base de datos: Railway entrega esta referencia al agregar PostgreSQL.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=false

# Dominios
WEB_ORIGINS=https://app.TU-DOMINIO.com
WEB_APP_URL=https://app.TU-DOMINIO.com
INSTITUTIONAL_EMAIL_DOMAINS=univalle.edu,est.univalle.edu
APP_TIMEZONE=America/La_Paz
# 2 si api.TU-DOMINIO.com pasa por el proxy de Cloudflare (nube naranja); 1 si no.
TRUST_PROXY_HOPS=1

# Sesión. Generar cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true

# Primera cuenta de Administración
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Archivos en Cloudflare R2 (bucket privado)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET=afinia-archivos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Correo por Brevo (Railway bloquea SMTP en sus planes básicos)
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
MAIL_FROM=no-responder@TU-DOMINIO.com
MAIL_FROM_NAME=Afinia
